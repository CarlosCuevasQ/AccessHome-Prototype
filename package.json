{
  "name": "accesshome",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "tsc --noEmit && vite build",
    "build:vercel": "tsc --noEmit && vite build --mode shared && node scripts/check-dist.mjs",
    "deployment:check": "node scripts/check-dist.mjs",
    "preview": "vite preview",
    "backend:check": "node scripts/check-backend.mjs",
    "test": "tsc -p tests/tsconfig.json && node --test tests/*.test.mjs",
    "test:concurrency": "node --test tests/concurrency/*.test.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "embedded-postgres": "17.10.0-beta.17",
    "pg": "8.23.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0"
  }
}
